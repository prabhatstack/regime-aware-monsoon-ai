# ==============================================================================
# Regime-Aware AI Post-Processing Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# Note: All settings have sensible fallback defaults for 1-click execution.
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
APP_ENV=development

# Debug Mode: True / False
DEBUG=True

# Backend Server Binding
API_HOST=127.0.0.1
API_PORT=8000

# Security and Secret Key (Change this in production)
AUTH_SECRET_KEY=dev_secret_key_monsoon_jharkhand_2026

# Allowed CORS Origins (comma-separated, e.g. http://localhost:3000,http://127.0.0.1:8000 or *)
CORS_ORIGINS=*

# Directory Paths (Relative to repository root or absolute)
DATA_DIR=data
MODELS_DIR=models
